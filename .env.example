# Frontend (Vite) environment variables
# Copy this file to .env.local and fill in values for local development
# Note: Only variables prefixed with VITE_ are exposed to the browser

VITE_TURNSTILE_SITE_KEY=

# Backend/serverless environment variables (NOT exposed to the browser)
RESEND_API_KEY=
FROM_EMAIL=
TO_EMAIL=
TURNSTILE_SECRET_KEY=
